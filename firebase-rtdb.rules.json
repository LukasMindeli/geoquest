{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "joined": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "leaderboard": {
      "$type": {
        ".read": true,
        ".indexOn": ["score"],

        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($type === 'alltime' || $type === 'speed')",

          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "chat": {
      ".read": true,
      ".indexOn": ["ts"],

      "$msgid": {
        ".write": "auth != null",

        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
        },
        "uid": {
          ".validate": "auth != null && newData.isString() && newData.val() === auth.uid"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "matchmaking": {
      ".read": "auth != null",
      ".indexOn": ["ts"],

      "$slot": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid) || (data.exists() && !data.child('matched').exists() && newData.child('matched').val() === auth.uid && newData.child('uid').val() === data.child('uid').val() && newData.child('name').val() === data.child('name').val() && newData.child('ts').val() === data.child('ts').val() && newData.child('peerId').val() === data.child('peerId').val() && newData.child('mode').val() === data.child('mode').val() && newData.child('reg').val() === data.child('reg').val()))",

        "uid": {
          ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 128"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now + 10000"
        },
        "peerId": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length >= 3 && newData.val().length <= 32)"
        },
        "mode": {
          ".validate": "newData.isString() && (newData.val() === 'click' || newData.val() === 'type' || newData.val() === 'capital' || newData.val() === 'flag' || newData.val() === 'landmark' || newData.val() === 'leader' || newData.val() === 'religion')"
        },
        "reg": {
          ".validate": "newData.isString() && (newData.val() === 'world' || newData.val() === 'europe' || newData.val() === 'asia' || newData.val() === 'eurasia' || newData.val() === 'americas' || newData.val() === 'africa' || newData.val() === 'oceania')"
        },
        "matched": {
          ".validate": "!newData.exists() || (auth != null && newData.isString() && newData.val() === auth.uid)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
